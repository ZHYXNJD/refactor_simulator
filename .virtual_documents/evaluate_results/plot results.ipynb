# 假设 df_dist 和 df_value 分别是两种模式下的订单记录表
# 包含字段: 'order_distance', 'match_wait_time', 'is_matched'

def analyze_wait_time(df, strategy_name):

    # 3. 按距离分箱 (Binning)，例如 0-3km, 3-6km, ...
    # df['dist_bin'] = pd.cut(df['trip_distance'], bins=[0, 3, 6, 10, 15], labels=['Short', 'Medium', 'Long', 'Ultra-Long'])
    df['dist_bin'] = pd.cut(df['trip_time'], bins=[0, 300, 600, 5000], labels=['Short', 'Medium', 'Long'])

    # 4. 分组统计等待时间
    wait_time_by_bin = df.groupby('dist_bin')['wait_time'].mean()
    # print(f"[{strategy_name}] Wait Time by Distance:\n{wait_time_by_bin}\n")
    print(f"[{strategy_name}] Wait Time by Trip time:\n{wait_time_by_bin}\n")
    print(f"average wait time: {df['wait_time'].mean()}\n")
    return wait_time_by_bin


def analyze_pick_time(df, strategy_name):

    # 3. 按距离分箱 (Binning)，例如 0-3km, 3-6km, ...
    df['dist_bin'] = pd.cut(df['trip_distance'], bins=[0, 3, 6, 10, 15], labels=['Short', 'Medium', 'Long', 'Ultra-Long'])

    # 4. 分组统计等待时间
    wait_time_by_bin = df.groupby('dist_bin')['pickup_time'].mean()
    print(f"[{strategy_name}] Pickup Time by Distance:\n{wait_time_by_bin}\n")
    print(f"average pickup time: {df['pickup_time'].mean()}\n")
    return wait_time_by_bin


