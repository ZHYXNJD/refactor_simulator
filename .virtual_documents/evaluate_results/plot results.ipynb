# column list for npy data
cl = ['origin_grid_id','total_request_num', 'long_request_num', 'medium_request_num', 'short_request_num',
'total_reward', 'matched_request_num','matched_long_request_num', 'matched_medium_request_num',
 'matched_short_request_num','waiting_time', 'pickup_time', 'matched_long_request_ratio',
 'matched_medium_request_ratio','matched_short_request_ratio', 'matched_request_ratio']
key2index = {each:i for i,each in enumerate(cl)}
def aggregate_npy(npy_data,key,interval,grid):
    index = key2index[key]
    return np.array(([npy_data[t][k][index] for t in range(300) for k in range(grid)])).reshape(int(300/interval),int(interval),grid).sum(axis=1)


